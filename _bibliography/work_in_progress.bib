@article{zhao2026spontaneous,
  title        = {Records and the Micro-Foundations of Spontaneous Authority and Property Rights: Evidence from Rule-Based and AI Agents},
  author       = {Xu, Chenggang and Zhao, Albert Bo and Zhou, Yi},
  year         = {2026},
  month        = {September},
  abstract     = {Without a state, formal law, or police, how do people spontaneously begin to follow a leader (authority) and respect others' possessions (property rights)? We study the micro-foundations of these two institutions using a controlled computational laboratory. By pre-generating and freezing all random events in advance, we place traditional rule-based agents (ABM) and modern Large Language Model agents (DeepSeek, GPT-6, and Gemini) into identical parallel worlds and directly compare their choices. Our experiments reveal four clear findings. First, shared records affect authority and property in fundamentally different ways: in group decision-making, accurate records of past performance are sufficient on their own to make agents voluntarily follow the most capable leader; however, giving someone an official title without a real track record only creates blind following around a name. Second, in conflicts over scarce resources, shared records are necessary but not sufficient for property rights: knowing who claimed a resource first does not stop others from grabbing it unless agents also hold a behavioral norm to back down or face lasting exclusion for intruding. Third, AI agents display a striking gap between words and actions: in resource conflicts, Large Language Models verbally recognize others' claims 75\%--100\% of the time, yet still step in to grab the resource over 95\% of the time, triggering costly cycles of mutual punishment unless they are guided to honor their word or allowed to vote after experiencing conflict. Fourth, once established, authority built on accumulated past reputation is slow to change when a leader loses competence, whereas property arrangements with clear rules for challenging and transferring claims adapt quickly. Together, these findings clarify how shared information and behavioral restraint jointly give rise to spontaneous social order.}
}

@article{zhao2026machinelearned,
  title        = {Machine-Learned Factors},
  author       = {Bi, Huanqiao and Cheng, Tingting and Zhao, Albert Bo},
  year         = {2026},
  month        = {October},
  abstract     = {Can machine learning autonomously discover cross-sectional asset pricing factors without degenerating into an uninterpretable black box? We examine this question by designing a formulaic reinforcement learning framework that searches for explicit return predictors in Reverse Polish Notation (RPN). Operating on 1,712,870 CRSP/Compustat firm-month observations over 1965--2024 under strict formulaic, numerical, unit, and horizon constraints, a Maskable PPO agent is rewarded by panel Fama-MacBeth $t$-statistics controlling for standard benchmark factors. By benchmarking reinforcement learning (RL) against both uniform random sampling (RS) within the same grammar and canonical two-variable data-mining operators (CLZ), our empirical analysis reveals four main findings. First, representation space dominates search optimization: while the formulaic RPN framework outperforms canonical literature operators by a wide margin (15.75\% vs. 11.50\% in univariate sort hurdles), the incremental advantage of reinforcement learning over random sampling is narrow (12.75\% vs. 12.50\% in Fama-MacBeth hurdles), concentrated in earlier decades, and completely vanishes after 2005. Second, machine-learned factors achieve substantial dimension reduction: portfolios constructed from only 200 RL-mined signals via neural networks generate an equal-weighted monthly return of 1.22\% with an annual Sharpe ratio of 1.20, matching the predictive performance of brute-force universes containing over 18,000 raw characteristics. Third, structural dissection reveals that the agent gravitates toward ratio-based expressions, scaling profitability, accrual, and momentum metrics by economic scale bases. Fourth, when subjected to a multi-agent Large Language Model debate as an ex-post interpretability hurdle, RL signals survive at two to three times the rate of random expressions (1.50\%--3.50\% vs. 1.00\%), yet lag far behind published human factors (49.64\%), demonstrating that statistical significance does not equate to economic plausibility. Together, these results delineate the exact boundaries of AI-driven factor discovery, showing that while symbolic algorithms excel at compressing cross-sectional predictability, human domain knowledge remains essential for defining the economic grammar and enforcing theoretical plausibility.}
}
