{% if site.enable_google_analytics %}
  <!-- Global site tag (gtag.js) - Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', '{{ site.google_analytics }}');
  </script>
{% endif %}
{% if site.enable_cronitor_analytics %}
  <!-- Cronitor RUM -->
  <script async src="https://rum.cronitor.io/script.js"></script>
  <script>
    window.cronitor =
      window.cronitor ||
      function () {
        (window.cronitor.q = window.cronitor.q || []).push(arguments);
      };
    cronitor('config', { clientKey: '{{ site.cronitor_analytics }}' });
  </script>
{% endif %}
{% if site.enable_pirsch_analytics %}
  <script
    defer
    src="https://api.pirsch.io/pa.js"
    id="pianjs"
    data-code="{{ site.pirsch_analytics }}"
  ></script>
{% endif %}
{% if site.enable_openpanel_analytics %}
  <script>
    window.op =
      window.op ||
      function (...args) {
        (window.op.q = window.op.q || []).push(args);
      };
    window.op('init', {
      clientId: '{{ site.openpanel_analytics }}',
      trackScreenViews: true,
      trackOutgoingLinks: true,
      trackAttributes: true,
    });
  </script>
  <script src="https://openpanel.dev/op1.js" defer async></script>
{% endif %}
{% if site.enable_goatcounter and site.goatcounter_code %}
  <!-- GoatCounter -->
  <script>
    window.__normalizeGoatPath = function (p) {
      if (!p) return '/';
      try {
        p = decodeURIComponent(p);
      } catch (e) {}
      if (p.length > 1 && p.charAt(p.length - 1) === '/') {
        p = p.slice(0, -1);
      }
      return p;
    };
    window.goatcounter = {
      path: window.__normalizeGoatPath,
    };
  </script>
  <script data-goatcounter="https://{{ site.goatcounter_code }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var els = document.querySelectorAll('[data-gc-path]');
      if (!els.length) return;
      var base = 'https://{{ site.goatcounter_code }}.goatcounter.com/counter/';
      var cache = {};
      els.forEach(function (el) {
        var rawPath = el.getAttribute('data-gc-path');
        if (!rawPath) return;
        var normPath = window.__normalizeGoatPath(rawPath);
        if (!cache[normPath]) {
          cache[normPath] = fetch(base + encodeURIComponent(normPath) + '.json')
            .then(function (res) {
              if (res.ok) return res.json();
              if (res.status === 404) return { count: '0' };
              return null;
            })
            .catch(function () {
              return null;
            });
        }
        cache[normPath].then(function (data) {
          if (!data || typeof data.count === 'undefined') return;
          var numEl = el.querySelector('.gc-count-num');
          if (numEl) numEl.textContent = data.count;
          el.hidden = false;
        });
      });
    });
  </script>
{% endif %}
